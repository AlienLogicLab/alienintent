{"schema_version":"1.0","event_id":"py09-012-liveness-suppressed","project":"AlienIntent","repository":"AlienLogicLab/alienintent","biu_id":"PY-09","issue_number":57,"event_type":"LIVENESS_SUPPRESSED","actor_role":"COORDINATOR","started_at":"2026-09-21T02:14:05Z","result":"RECOVERY_HELD","authority_ref":"docs/decisions/2026-09-20-liveness-reconciliation.md#swf-29","observation_type":"worker claim","verified":true,"description":"Liveness reconciliation was suppressed for this lane rather than re-emitting the trigger. Relaunching would start a producer that hits the same quota wall within minutes and would keep doing so every grace period. The durable attention item stays open and recovery resumes only on explicit resolution. This is the SWF-29 rule produced by PY-07's incident, applied to a condition PY-07 did not contain.","evidence_refs":["https://github.com/AlienLogicLab/alienintent/issues/57#issuecomment-5754528659"],"recorded_at":"2026-09-21T02:45:00Z","recorder":"PY-05..PY-09 evidence reconstruction batch, captured 2026-09-21T02:45Z"}
