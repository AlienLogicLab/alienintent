{"schema_version":"1.0","event_id":"py09-016-provider-identity","project":"AlienIntent","repository":"AlienLogicLab/alienintent","biu_id":"PY-09","issue_number":57,"event_type":"PROVIDER_IDENTITY_OBSERVED","actor_role":"COORDINATOR","started_at":"2026-09-21T02:14:05Z","result":"OBSERVED","observation_type":"worker claim","verified":true,"description":"The capacity incident is the only place in PY-05..PY-09 where actor provider identity becomes durable: the PRODUCER adapter is codex under provider-default funding, and the VERIFIER runs on the claude adapter under a separate subscription. This is stated by the coordinator for PY-09. The dispatcher state record carries no provider field for any invocation, so the same assignment in PY-05..PY-08 is an inference and is recorded as UNKNOWN there.","evidence_refs":["https://github.com/AlienLogicLab/alienintent/issues/57#issuecomment-5754528659","https://github.com/AlienLogicLab/alienintent/issues/57#issuecomment-5754575853"],"recorded_at":"2026-09-21T02:45:00Z","recorder":"PY-05..PY-09 evidence reconstruction batch, captured 2026-09-21T02:45Z"}
