#!/usr/bin/env python3
"""JSON lifecycle eligibility of one TASKS or READY BIU, for the Node dispatcher.

    lifecycle-eligibility --issue 147 --director-host-config <path> --active-claims 0

The gate (`tools/live/release_admission.py`: `gather` + `eligibility`) decides; this adapter
only makes its result machine-readable and adds the Director-host inputs that govern every
launch (contract section 9): the WIP limit, Founder holds and the pause flag.

The dispatcher owns worker claims, so it supplies the count of claims whose worker is
genuinely alive. A persisted record whose process is gone does not occupy WIP.

Output: {"agentReady": str|null, "prepared": bool, "admitted": bool,
         "failures": [{"check": str, "why": str}], "priority": {...}}.
Exit 0 whenever a result was produced; any other exit is an eligibility error.
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "tools" / "live"))
import release_admission  # noqa: E402


def host_failures(host: dict, issue: int) -> list[dict]:
    failures = []
    pause = host.get("pauseFlag")
    try:
        # Presence only, of any file type; a location that cannot be checked fails closed.
        if not isinstance(pause, str):
            raise ValueError("pause flag not configured")
        if Path(pause).exists() or Path(pause).is_symlink():
            failures.append({"check": "factory_paused", "why": "Factory execution is explicitly paused."})
    except (OSError, ValueError):
        failures.append({"check": "factory_pause_unknown", "why": "The pause flag could not be checked."})
    try:
        record = json.loads(Path(host["founderHoldRecord"]).read_text())
        holds = record["holds"]
        if record.get("schemaVersion") != 1 or not isinstance(holds, list):
            raise ValueError("schema")
        if any(isinstance(hold, dict) and hold.get("issue") == issue for hold in holds):
            failures.append({"check": "founder_hold", "why": "The Founder-hold record covers this Issue."})
    except (OSError, KeyError, TypeError, ValueError):
        failures.append({"check": "founder_holds_unknown", "why": "The Founder-hold record could not be read."})
    return failures


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--issue", type=int, required=True)
    parser.add_argument("--director-host-config", required=True)
    parser.add_argument("--active-claims", type=int, required=True)
    args = parser.parse_args(argv)
    host_path = Path(args.director_host_config)
    host = json.loads(host_path.read_text())
    # The gate reads wipLimit and operators from the same host configuration the Director host uses.
    release_admission.HOST_CONFIG = host_path
    facts = release_admission.gather(args.issue, stop_without_ready_receipt=True)
    facts["active_claims_total"] = args.active_claims
    # The dispatcher never asks about a BIU it holds a live claim for.
    facts["active_invocations"] = []
    result = release_admission.eligibility(facts, host_failures(host, args.issue))
    print(json.dumps({**result, "priority": facts.get("priority_reconciliation")}, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
